<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SliceCraft.SpeedrunMod</AssemblyName>
    <Product>SpeedrunMod</Product>
    <Version>1.4.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>SpeedrunMod</RootNamespace>
    <DeployAssemblies Condition="'$(DeployAssemblies)' == ''">SliceCraft.SpeedrunMod.dll,SliceCraft.MenuLib.dll</DeployAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Dependencies/*.dll" />
  </ItemGroup>

  <Target Name="DeployConfiguredAssembliesAfterBuild" AfterTargets="Build" Condition="'$(DeployOutputDir)' != ''">
    <ItemGroup>
      <DeployAssembly Include="$([System.String]::Copy('$(DeployAssemblies)').Split(','))" />
      <DeployFile Include="@(DeployAssembly->'$(TargetDir)%(Identity)')" Condition="Exists('$(TargetDir)%(Identity)')" />
      <MissingDeployAssembly Include="@(DeployAssembly)" Condition="!Exists('$(TargetDir)%(Identity)')" />
    </ItemGroup>

    <MakeDir Directories="$(DeployOutputDir)" />
    <Copy
      SourceFiles="@(DeployFile)"
      DestinationFiles="@(DeployFile->'$(DeployOutputDir)/%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />

    <Warning Text="Deploy skipped missing file: %(MissingDeployAssembly.Identity)" Condition="'@(MissingDeployAssembly)' != ''" />
    <Message Text="Deployed @(DeployFile->'%(Filename)%(Extension)', ', ') to $(DeployOutputDir)" Importance="high" Condition="'@(DeployFile)' != ''" />
  </Target>
</Project>
